NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Show "Continue with Apple" on the web. Requires a Services ID and key
# configured under Authentication -> Providers -> Apple, or the button 400s.
# Native iOS shows Apple regardless of this flag.
NEXT_PUBLIC_APPLE_WEB_AUTH=false
